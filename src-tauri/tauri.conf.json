{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyboard Mouse Overlay",
  "version": "1.0.0",
  "identifier": "com.ronaldmorgan99.kbmoverlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keyboard Mouse Overlay",
        "width": 800,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "url": "index.html?transparent=1",
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
